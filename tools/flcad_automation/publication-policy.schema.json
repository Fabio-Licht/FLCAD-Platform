{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flcad.local/schemas/flcad-publication-policy-1.0.json",
  "title": "FLCAD recurring report publication policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "policy_id", "enabled", "destination_branch", "allowed_files", "max_packages_per_run", "max_total_bytes", "max_package_bytes", "push_mode"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "policy_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,63}$" },
    "enabled": { "const": true },
    "destination_branch": { "const": "automation/reports" },
    "allowed_files": { "type": "array", "const": ["report.json", "review-request.json", "manifest.json"] },
    "max_packages_per_run": { "type": "integer", "minimum": 1, "maximum": 20 },
    "max_total_bytes": { "type": "integer", "minimum": 1, "maximum": 52428800 },
    "max_package_bytes": { "type": "integer", "minimum": 1, "maximum": 10485760 },
    "push_mode": { "const": "operator-authorized-only" },
    "push_enabled": { "type": "boolean" }
  }
}
