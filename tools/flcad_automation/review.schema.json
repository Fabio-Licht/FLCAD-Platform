{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flcad.local/schemas/flcad-automation-review-1.0.json",
  "title": "FLCAD supervised report review",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "report_sha256", "review_status", "reviewer", "tests_decision", "risk_decision", "acceptance_decision", "findings", "required_actions"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "task_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,63}$" },
    "report_sha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
    "review_status": { "enum": ["awaiting-review", "approved", "rejected"] },
    "reviewer": { "type": "string", "minLength": 1, "maxLength": 200 },
    "tests_decision": { "enum": ["pass", "fail", "insufficient"] },
    "risk_decision": { "enum": ["accepted", "mitigate", "blocked"] },
    "acceptance_decision": { "enum": ["met", "not-met", "pending"] },
    "findings": { "type": "array", "items": { "type": "string" } },
    "required_actions": { "type": "array", "items": { "type": "string" } },
    "reviewed_at": { "type": "string" }
  }
}
