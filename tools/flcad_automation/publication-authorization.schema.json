{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flcad.local/schemas/flcad-publication-authorization-1.0.json",
  "title": "FLCAD one-time publication authorization",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "authorization_id", "task_id", "package_path", "package_sha256", "branch", "expected_remote_sha", "max_publications", "expires_at", "state"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "authorization_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{7,127}$" },
    "task_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,63}$" },
    "package_path": { "type": "string", "minLength": 1 },
    "package_sha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
    "branch": { "const": "automation/reports" },
    "expected_remote_sha": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$" },
    "max_publications": { "const": 1 },
    "expires_at": { "type": "string", "format": "date-time" },
    "state": { "enum": ["issued", "consumed", "published", "unconfirmed", "expired"] },
    "candidate_commit": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$" },
    "issued_at": { "type": "string", "format": "date-time" },
    "consumed_at": { "type": "string", "format": "date-time" },
    "completed_at": { "type": "string", "format": "date-time" },
    "failure": { "type": "string", "maxLength": 2000 }
  }
}
