{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flcad.local/schemas/flcad-automation-task-1.0.json",
  "title": "FLCAD supervised automation task",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "objective",
    "sourceBranch",
    "baseCommit",
    "allowedPaths",
    "requiredTests",
    "acceptanceCriteria",
    "limits",
    "permissions",
    "state",
    "reportPath",
    "action"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,63}$"
    },
    "objective": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "sourceBranch": { "type": "string", "minLength": 1, "maxLength": 255 },
    "baseCommit": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$" },
    "allowedPaths": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "requiredTests": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "acceptanceCriteria": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxDurationSeconds", "maxOutputBytes"],
      "properties": {
        "maxDurationSeconds": { "type": "integer", "minimum": 1, "maximum": 3600 },
        "maxOutputBytes": { "type": "integer", "minimum": 1024, "maximum": 10485760 }
      }
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workspaceWrite", "network", "gitMutation", "remotePublish"],
      "properties": {
        "workspaceWrite": { "const": false },
        "network": { "const": false },
        "gitMutation": { "const": false },
        "remotePublish": { "const": false }
      }
    },
    "state": { "enum": ["approved"] },
    "reportPath": {
      "type": "string",
      "pattern": "^(?![A-Za-z]:)(?!/)(?!\\\\)(?!.*(?:^|[/\\])\\.\\.(?:[/\\]|$)).+\\.json$"
    },
    "action": { "enum": ["environment", "codex-environment-probe"] }
  }
}
