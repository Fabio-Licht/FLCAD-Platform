{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flcad.local/schemas/flcad-report-decision-1.0.json",
  "title": "FLCAD independent report decision",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "report_sha256", "analyzed_commit", "decision", "reviewer", "findings", "required_actions"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "task_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,63}$"},
    "report_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
    "analyzed_commit": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
    "decision": {"enum": ["APPROVED", "CHANGES_REQUESTED", "BLOCKED", "HUMAN_REVIEW_REQUIRED"]},
    "reviewer": {"type": "string", "minLength": 1, "maxLength": 200},
    "findings": {"type": "array", "items": {"type": "string", "maxLength": 2000}},
    "required_actions": {"type": "array", "items": {"type": "string", "maxLength": 2000}},
    "decided_at": {"type": "string"}
  }
}
