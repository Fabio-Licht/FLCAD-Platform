{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flcad.local/schemas/flcad-independent-review-1.0.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "analyzed_commit", "report_sha256", "decision", "findings", "criteria_verified", "reviewed_at", "reviewer_identity", "reviewer_execution_id"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "task_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,63}$"},
    "analyzed_commit": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
    "report_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
    "decision": {"enum": ["APPROVED", "CHANGES_REQUESTED", "BLOCKED", "HUMAN_REVIEW_REQUIRED"]},
    "findings": {"type": "array", "items": {"type": "string", "maxLength": 2000}},
    "criteria_verified": {"type": "boolean"},
    "reviewed_at": {"type": "string", "minLength": 1},
    "reviewer_identity": {"type": "string", "minLength": 1, "maxLength": 200},
    "reviewer_execution_id": {"type": "string", "minLength": 1, "maxLength": 200}
  }
}
