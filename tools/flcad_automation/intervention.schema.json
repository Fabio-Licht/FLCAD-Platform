{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flcad.local/schemas/flcad-human-intervention-1.0.json",
  "title": "FLCAD supervised human intervention",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "event", "state", "reason", "priority", "action_requested", "technical_summary", "report_reference", "branch", "commit", "deduplication_id", "execution_mode", "gui_control_authorization", "notification_status"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "task_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,63}$" },
    "event": { "enum": ["USER_TEST_REQUIRED", "USER_APPROVAL_REQUIRED", "AGENT_BLOCKED"] },
    "state": { "enum": ["RUNNING", "READY_FOR_REVIEW", "WAITING_FOR_USER", "BLOCKED", "COMPLETED"] },
    "reason": { "type": "string", "minLength": 1, "maxLength": 1000 },
    "priority": { "enum": ["P0", "P1", "P2", "P3"] },
    "action_requested": { "type": "string", "minLength": 1, "maxLength": 1000 },
    "technical_summary": { "type": "string", "minLength": 1, "maxLength": 4000 },
    "report_reference": { "type": "string", "minLength": 1, "maxLength": 500 },
    "branch": { "type": "string", "minLength": 1 },
    "commit": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$" },
    "deduplication_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$" },
    "execution_mode": { "enum": ["HEADLESS_DEVELOPMENT", "GUI_TEST_REQUESTED"] },
    "gui_control_authorization": { "enum": ["not-granted", "granted-explicitly"] },
    "notification_status": { "enum": ["local", "prepared-for-publication", "published", "deduplicated", "handled"] },
    "handled": { "type": "object", "additionalProperties": false, "required": ["handled_by", "handled_at", "resolution"], "properties": { "handled_by": { "type": "string" }, "handled_at": { "type": "string" }, "resolution": { "type": "string" } } }
  }
}
